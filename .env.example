# Configure these in Vercel for each environment; never commit real values.
CASTELEIN_SITE_ORIGIN=https://castelein.eu.com
ENQUIRY_FORMS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# A plain sender address authorized by the SMTP provider.
SMTP_FROM=
ENQUIRY_PERSONAL_TO=paul@skaler.pt
# Optional additional exact HTTPS origins, comma-separated. Local testing also
# allows http://localhost:PORT and http://127.0.0.1:PORT. No wildcard origins.
CONTACT_ALLOWED_ORIGINS=
